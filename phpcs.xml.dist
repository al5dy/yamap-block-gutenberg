<?xml version="1.0"?>
<ruleset name="Yandex Maps for Gutenberg">
	<description>WordPress and PHP compatibility rules for Yandex Maps for Gutenberg.</description>

	<file>yamap-block-gutenberg.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>build</file>
	<file>tests/php</file>

	<exclude-pattern>build/*.asset.php</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>

	<arg name="basepath" value="." />
	<arg name="colors" />
	<arg value="sp" />
	<arg name="extensions" value="php" />

	<config name="testVersion" value="7.4-" />

	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Extra" />
	<rule ref="WordPress-Docs" />
	<rule ref="PHPCompatibilityWP" />

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="yamap-block-gutenberg" />
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="guyamap" />
				<element value="GUYAMAP" />
			</property>
		</properties>
	</rule>

	<!-- These PSR-4-style public paths are part of the documented extension API. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>includes/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>includes/*</exclude-pattern>
	</rule>
</ruleset>
