{
	"name": "yamap-block-gutenberg",
	"version": "2.0.1",
	"description": "Yandex Maps for Gutenberg — a fast, accessible WordPress map block with markers and clustering.",
	"license": "GPL-3.0-or-later",
	"private": true,
	"files": [
		"assets/icons/",
		"build/",
		"includes/",
		"languages/",
		"LICENSE",
		"LICENSES/",
		"readme.txt",
		"third-party-notices.txt",
		"uninstall.php",
		"yamap-block-gutenberg.php"
	],
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss'",
		"test:unit": "wp-scripts test-unit-js",
		"test:e2e": "node scripts/run-e2e.js",
		"test:e2e:direct": "playwright test",
		"test:e2e:headed": "GUYAMAP_E2E_HEADED=1 node scripts/run-e2e.js",
		"test:e2e:browsers": "GUYAMAP_E2E_BROWSERS=chromium,firefox,webkit node scripts/run-e2e.js",
		"test:package": "bash scripts/test-package-smoke.sh",
		"test:plugin-check": "bash scripts/test-plugin-check.sh",
		"plugin-zip": "node scripts/plugin-zip.js",
		"verify:package": "node scripts/verify-package.js",
		"audit:source": "node scripts/audit-source.js",
		"check:versions": "node scripts/check-versions.js",
		"i18n:build": "bash scripts/build-translations.sh",
		"i18n:check": "bash scripts/check-translations.sh",
		"release": "bash scripts/release-wordpress-org.sh",
		"icons:manifest": "node scripts/generate-icon-manifest.js",
		"icons:check": "node scripts/generate-icon-manifest.js --check",
		"icons:verify": "node scripts/vendor-icons.js",
		"icons:update": "node scripts/vendor-icons.js --update"
	},
	"dependencies": {
		"@yandex/ymaps3-clusterer": "0.0.12"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@wordpress/block-editor": "16.2.0",
		"@wordpress/blocks": "15.26.0",
		"@wordpress/components": "39.0.0",
		"@wordpress/element": "8.5.0",
		"@wordpress/i18n": "6.26.0",
		"@wordpress/scripts": "34.1.0",
		"@yandex/ymaps3-default-ui-theme": "0.0.25",
		"adm-zip": "0.6.1"
	}
}
